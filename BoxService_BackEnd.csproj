<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Database\" />
        <Folder Include="Controllers\" />
        <Folder Include="Models\" />
        <Folder Include="Services\" />
        <Folder Include="Repositories\" />
        <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Supabase" Version="8.1.0" />
    </ItemGroup>

    <!-- Pipeline viejo (HttpListener), de antes de la migración a ASP.NET
         Core — Program.cs es el entry point real hoy, este cluster nunca
         se instancia ni se ejecuta. Se excluye de la build en vez de
         reescribirlo para que coincida con firmas nuevas (ej. tenantId
         en los Services) porque es código muerto, no algo que siga
         vigente. -->
    <ItemGroup>
        <Compile Remove="Controllers\**\*.cs" />
        <Compile Remove="Router\**\*.cs" />
        <Compile Remove="Server.cs" />
        <Compile Remove="ResponseHelper.cs" />
    </ItemGroup>

    <!-- El proyecto web vive en la raíz: no incluir el proyecto de pruebas. -->
    <ItemGroup>
        <Compile Remove="tests/**" />
        <Content Remove="tests/**" />
        <None Remove="tests/**" />
        <EmbeddedResource Remove="tests/**" />
    </ItemGroup>

    <!-- Copia las migraciones SQL al directorio de compilación -->
    <ItemGroup>
        <None Update="Database\migrations\*.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Copia appsettings.json al directorio de compilación -->
    <!-- appsettings.json NO va a GitHub — cada uno tiene el suyo -->
    <ItemGroup>
        <None Update="appsettings.json" Condition="Exists('appsettings.json')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.example.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
